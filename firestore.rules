rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidTask(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             data.category in ['WORK', 'PERSONAL', 'HEALTH', 'ROUTINE'] &&
             data.priority in ['HIGH', 'MEDIUM', 'LOW'] &&
             (!('scheduledTime' in data) || (data.scheduledTime is string && data.scheduledTime.size() <= 40)) &&
             data.completed is bool;
    }

    function isValidPermissions(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.masterEnabled is bool &&
             data.allowVoiceMic is bool &&
             data.allowTtsSpeech is bool &&
             data.allowFlashlight is bool &&
             data.allowVolumeControl is bool &&
             data.allowDisplayAndSettings is bool &&
             data.allowAlarmsAndTimers is bool &&
             data.allowDialer is bool &&
             data.allowNotifications is bool &&
             data.assistantLanguage in ['bn', 'en', 'bilingual'] &&
             (!('assistantName' in data) || (data.assistantName is string && data.assistantName.size() >= 1 && data.assistantName.size() <= 40)) &&
             (!('conversationStyle' in data) || data.conversationStyle in ['FRIENDLY', 'POLITE', 'CASUAL', 'CONCISE', 'CUSTOM']) &&
             (!('customStylePrompt' in data) || (data.customStylePrompt is string && data.customStylePrompt.size() <= 300)) &&
             (!('voiceGender' in data) || data.voiceGender in ['FEMALE', 'MALE']) &&
             (!('voiceLocale' in data) || data.voiceLocale in ['bn-BD', 'bn-IN', 'en-US']) &&
             (!('voicePersona' in data) || data.voicePersona in ['FEMALE_WARM', 'FEMALE_CRISP', 'MALE_CALM', 'MALE_ENERGETIC']);
    }

    function isValidActionLog(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.actionType is string && data.actionType.size() >= 1 && data.actionType.size() <= 64 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 200 &&
             data.status in ['EXECUTED', 'BLOCKED_PERMISSION', 'FAILED'] &&
             data.permissionKey is string && data.permissionKey.size() <= 64;
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.sender in ['USER', 'ASSISTANT'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 4000 &&
             data.actionLabel is string && data.actionLabel.size() <= 160 &&
             data.actionStatus in ['NONE', 'EXECUTED', 'BLOCKED_PERMISSION', 'TASK_UPDATED'] &&
             data.clientOrder is int && data.clientOrder >= 0;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.displayName is string && data.displayName.size() <= 80 &&
             (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 50)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('googlePhotoUrl' in data) || (data.googlePhotoUrl is string && data.googlePhotoUrl.size() <= 500)) &&
             (!('customPhotoUri' in data) || (data.customPhotoUri is string && data.customPhotoUri.size() <= 500));
    }

    function isValidUserAccount(data, userId) {
      return data.uid is string &&
             data.uid == userId &&
             data.displayName is string && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    match /users/{userId} {
      allow list: if false;
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       incoming().keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserAccount(incoming(), userId) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);
      allow update: if isOwner(userId) &&
                       isValidUserAccount(incoming(), userId) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);
      allow delete: if isOwner(userId);

      match /tasks/{taskId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(taskId);
        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll(['userId', 'title', 'category', 'priority', 'completed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'note', 'category', 'priority', 'scheduledTime', 'completed', 'createdAt', 'updatedAt']) &&
                         isValidTask(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'note', 'category', 'priority', 'scheduledTime', 'completed', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /settings/{settingId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(settingId);
        allow create: if isOwner(userId) &&
                         isValidId(settingId) &&
                         settingId == 'permissions' &&
                         incoming().keys().hasAll([
                           'userId', 'masterEnabled', 'allowVoiceMic', 'allowTtsSpeech',
                           'allowFlashlight', 'allowVolumeControl', 'allowDisplayAndSettings',
                           'allowAlarmsAndTimers', 'allowDialer', 'allowNotifications',
                           'assistantLanguage', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'masterEnabled', 'allowVoiceMic', 'allowTtsSpeech',
                           'allowFlashlight', 'allowVolumeControl', 'allowDisplayAndSettings',
                           'allowAlarmsAndTimers', 'allowDialer', 'allowNotifications',
                           'assistantLanguage', 'assistantName', 'conversationStyle',
                           'customStylePrompt', 'voiceGender', 'voiceLocale', 'voicePersona', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidPermissions(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(settingId) &&
                         settingId == 'permissions' &&
                         isValidPermissions(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'masterEnabled', 'allowVoiceMic', 'allowTtsSpeech',
                           'allowFlashlight', 'allowVolumeControl', 'allowDisplayAndSettings',
                           'allowAlarmsAndTimers', 'allowDialer', 'allowNotifications',
                           'assistantLanguage', 'assistantName', 'conversationStyle',
                           'customStylePrompt', 'voiceGender', 'voiceLocale', 'voicePersona', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(settingId);
      }

      match /actionLogs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(logId);
        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll(['userId', 'actionType', 'summary', 'status', 'permissionKey', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'actionType', 'summary', 'status', 'permissionKey', 'createdAt']) &&
                         isValidActionLog(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      match /messages/{messageId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(messageId);
        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'sender', 'text', 'actionLabel', 'actionStatus', 'clientOrder', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'sender', 'text', 'actionLabel', 'actionStatus', 'clientOrder', 'createdAt']) &&
                         isValidChatMessage(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      match /profile/{profileId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(profileId);
        allow create: if isOwner(userId) &&
                         isValidId(profileId) &&
                         profileId == 'profile' &&
                         incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly([
                           'userId', 'displayName', 'nickname', 'email',
                           'bio', 'googlePhotoUrl', 'customPhotoUri', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidUserProfile(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isOwner(userId) &&
                         isValidId(profileId) &&
                         profileId == 'profile' &&
                         isValidUserProfile(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'nickname', 'email',
                           'bio', 'googlePhotoUrl', 'customPhotoUri', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(profileId);
      }
    }
  }
}
