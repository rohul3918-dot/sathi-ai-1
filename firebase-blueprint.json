{
  "entities": {
    "DailyTask": {
      "title": "DailyTask",
      "description": "A daily task or routine item organized by the user or AI assistant.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "note": { "type": "string" },
        "category": { "type": "string", "enum": ["WORK", "PERSONAL", "HEALTH", "ROUTINE"] },
        "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "scheduledTime": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "category", "priority", "completed", "createdAt", "updatedAt"]
    },
    "DevicePermissions": {
      "title": "DevicePermissions",
      "description": "User-selected AI device control permission switches and assistant personalization.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "masterEnabled": { "type": "boolean" },
        "allowVoiceMic": { "type": "boolean" },
        "allowTtsSpeech": { "type": "boolean" },
        "allowFlashlight": { "type": "boolean" },
        "allowVolumeControl": { "type": "boolean" },
        "allowDisplayAndSettings": { "type": "boolean" },
        "allowAlarmsAndTimers": { "type": "boolean" },
        "allowDialer": { "type": "boolean" },
        "allowNotifications": { "type": "boolean" },
        "assistantLanguage": { "type": "string", "enum": ["bn", "en", "bilingual"] },
        "assistantName": { "type": "string" },
        "conversationStyle": { "type": "string", "enum": ["FRIENDLY", "POLITE", "CASUAL", "CONCISE", "CUSTOM"] },
        "customStylePrompt": { "type": "string" },
        "voiceGender": { "type": "string", "enum": ["FEMALE", "MALE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "masterEnabled",
        "allowVoiceMic",
        "allowTtsSpeech",
        "allowFlashlight",
        "allowVolumeControl",
        "allowDisplayAndSettings",
        "allowAlarmsAndTimers",
        "allowDialer",
        "allowNotifications",
        "assistantLanguage",
        "createdAt",
        "updatedAt"
      ]
    },
    "DeviceActionLog": {
      "title": "DeviceActionLog",
      "description": "Audit log of device actions attempted or executed by the assistant.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "actionType": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string", "enum": ["EXECUTED", "BLOCKED_PERMISSION", "FAILED"] },
        "permissionKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "actionType", "summary", "status", "permissionKey", "createdAt"]
    },
    "ChatMessageRecord": {
      "title": "ChatMessageRecord",
      "description": "Persisted conversation message between the user and AI assistant.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sender": { "type": "string", "enum": ["USER", "ASSISTANT"] },
        "text": { "type": "string" },
        "actionLabel": { "type": "string" },
        "actionStatus": { "type": "string", "enum": ["NONE", "EXECUTED", "BLOCKED_PERMISSION", "TASK_UPDATED"] },
        "clientOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sender", "text", "actionLabel", "actionStatus", "clientOrder", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/DailyTask" },
      "description": "User's personal daily tasks and routines"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/DevicePermissions" },
      "description": "User's AI device control permissions and assistant personalization"
    },
    "/users/{userId}/actionLogs/{logId}": {
      "schema": { "$ref": "#/entities/DeviceActionLog" },
      "description": "Audit trail of AI device actions"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessageRecord" },
      "description": "Conversation history with AI assistant"
    }
  }
}
